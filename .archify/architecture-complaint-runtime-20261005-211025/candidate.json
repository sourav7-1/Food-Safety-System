  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "Student POSTs a complaint with up to 5 files",
        "Files are type-sniffed, hashed and written atomically to a private directory",
        "Complaint and evidence rows commit together; failures roll back"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Every POST needs the session CSRF token",
        "role_required gates student and inspector routes (403 otherwise)",
        "Evidence lives outside static/ and is served only through role-checked routes",
        "CSP limits scripts to self, jsDelivr and Turnstile"
      ]
    },
    {
      "dot": "amber",
      "title": "Database logic",
      "items": [
        "Risk level and reinspection date come from the calculate_stall_risk procedure",
        "Triggers validate inspection scores and corrective actions"
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown",
      "items": [
        "Vendor and admin portals share the same guards",
        "Browser loads Bootstrap/fonts from CDNs and map tiles from OpenStreetMap"
      ]
    }
  ]
