FLASK_APP=app.py
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
# Optional: how long a signed-in session stays valid without "remember
# me", in seconds. Defaults to 12 hours.
SESSION_LIFETIME_SECONDS=43200

MYSQL_HOST=localhost
MYSQL_PORT=port id
MYSQL_USER=user name
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=smart_street_food_safety

# Optional: set this instead of the individual MySQL values above.
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/smart_street_food_safety

# Optional: enables the "Continue with Google" login/register button.
# Leave blank to keep Google sign-in disabled. Create credentials at
# https://console.cloud.google.com/apis/credentials and add
# http://127.0.0.1:5000/auth/google/callback (and your production
# https:// callback URL) to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to actually deliver account email-verification links. Leave
# MAIL_SERVER blank during local development: with FLASK_DEBUG=True the
# app instead shows the verification link directly on the registration
# success page (never in logs), so the flow stays testable without SMTP.
# For Gmail, use an App Password (not your normal password) as
# MAIL_PASSWORD.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400

# Optional: Cloudflare Turnstile ("I'm not a robot" widget) on the
# registration form. Leave blank to skip Turnstile verification. Create
# a widget at https://dash.cloudflare.com/?to=/:account/turnstile -- add
# "localhost" to its allowed domains to use it before you deploy.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Flask-Limiter storage backend for register/login/resend rate
# limits. Defaults to in-process memory, which is fine for a single
# worker; use a shared backend (e.g. redis://localhost:6379) if you run
# more than one worker process.
RATELIMIT_STORAGE_URI=memory://

# Private storage for uploaded evidence (corrective actions and complaint
# evidence). Never under static/ -- this path is never served publicly,
# only through authenticated, authorization-checked download routes.
EVIDENCE_STORAGE_PATH=instance/evidence
EVIDENCE_MAX_FILES_PER_COMPLAINT=5
EVIDENCE_MAX_IMAGE_MB=10
EVIDENCE_MAX_AUDIO_MB=25
EVIDENCE_MAX_VIDEO_MB=100
EVIDENCE_MAX_DOCUMENT_MB=10
# Request-body ceiling Flask enforces before per-file validation even
# runs; must comfortably fit EVIDENCE_MAX_FILES_PER_COMPLAINT files at
# worst case. Not a per-file limit -- the EVIDENCE_MAX_*_MB values above
# are what actually cap each file.
EVIDENCE_MAX_REQUEST_MB=150

# Profile photo uploads (all roles). Public, like stall photos -- stored
# under static/uploads/profile_photos/ and served at the matching URL,
# resized/compressed on upload.
PROFILE_PHOTO_STORAGE_PATH=static/uploads/profile_photos
PROFILE_PHOTO_MAX_MB=5
PROFILE_PHOTO_MAX_DIMENSION=512
