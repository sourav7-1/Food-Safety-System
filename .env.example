FLASK_APP=app.py
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
UPLOAD_FOLDER=static/uploads/evidence

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=smart_street_food_safety

# Optional: set this instead of the individual MySQL values above.
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/smart_street_food_safety

# Optional: enables the "Continue with Google" login/register button.
# Leave blank to keep Google sign-in disabled. Create credentials at
# https://console.cloud.google.com/apis/credentials and add
# http://127.0.0.1:5000/auth/google/callback (and your production
# https:// callback URL) to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
